# BigQuery Configuration
# Option 1: Service account key file path
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Option 2: Service account key as JSON string (useful for deployment)
# BQ_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"..."}

# Your Google Cloud project ID
BQ_PROJECT_ID=your-project-id

# Default dataset (optional)
BQ_DEFAULT_DATASET=your_dataset

# Polling interval in milliseconds (default: 30000 = 30 seconds)
NEXT_PUBLIC_POLL_INTERVAL=30000

# Google Cloud project ID
BQ_PROJECT_ID=exalted-justice-470220-u6

# Option 1: Path to service account key JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Option 2: Service account key as inline JSON (for deployment / env var injection)
# BQ_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"exalted-justice-470220-u6",...}

# Polling interval for Live Feed (ms). Default: 30000 = 30 seconds
NEXT_PUBLIC_POLL_INTERVAL=30000

# Primary tables:
#   exalted-justice-470220-u6.ET_Leads_Detail.et_leads_details_latest  (primary leads)
#   exalted-justice-470220-u6.ET_Leads_Detail.marketing_report          (marketing source data)
#   exalted-justice-470220-u6.ET_Hist_Data.master_data_v2               (enriched historical)
#   exalted-justice-470220-u6.ET_Hist_Data.whatconverts_leads_raw       (raw lead tracking)
